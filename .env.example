# Environment Variables Example

# Backend Settings
DJANGO_SECRET_KEY=django-insecure-attendance-system-local-development-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,http://192.168.1.20:5173   
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173, http://192.168.1.20:5173/
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.20:5173/

# Database Settings (Leave blank or DB_ENGINE=sqlite for local development fallback, or provide PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db
DB_ENGINE=sqlite
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Office Network Settings
DEFAULT_OFFICE_IP=223.236.99.39
DEFAULT_OFFICE_TIMEZONE=Asia/Kolkata
NUM_PROXIES=0

# Frontend Settings (for frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
